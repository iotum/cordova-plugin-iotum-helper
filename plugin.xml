<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android" id="cordova-plugin-iotum-helper" version="1.3.0">
    <name>IotumHelper</name>
    <description>Iotum App Helpers</description>
    <author>Jerry Hu</author>

    <license>MIT</license>
    <keywords>cordova</keywords>

    <engines>
        <engine name="cordova" version=">=10.0.0" />
    </engines>

    <js-module src="www/iotum_helpers.js" name="IotumHelper">
        <clobbers target="cordova.plugins.iotumHelper" />
    </js-module>

    <platform name="ios">
        <config-file target="config.xml" parent="/*">
            <feature name="IotumHelper">
                <param name="ios-package" value="IotumHelperPlugin" />
                <param name="onload" value="true" />
            </feature>
        </config-file>

        <!-- Required for AVPictureInPictureController -->
        <framework src="AVKit.framework" />
        <framework src="CoreMedia.framework" />
        <framework src="CoreVideo.framework" />

        <!-- Background audio mode is required for PiP on iOS -->
        <config-file target="*-Info.plist" parent="UIBackgroundModes">
            <array>
                <string>audio</string>
            </array>
        </config-file>

        <header-file src="src/ios/IotumHelperPlugin.h" />
        <source-file src="src/ios/IotumHelperPlugin.m" />
    </platform>

    <platform name="android">
        <config-file parent="/*" target="res/xml/config.xml">
            <feature name="IotumHelper">
                <param name="android-package" value="com.iotum.iotumhelper" />
                <param name="onload" value="true" />
            </feature>
        </config-file>

        <!-- Declare that the app can use PiP (not required, just advisory) -->
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-feature android:name="android.software.picture_in_picture" android:required="false" />
        </config-file>

        <!-- Enable PiP on the main activity and handle config changes that occur during PiP -->
        <edit-config file="AndroidManifest.xml" target="/manifest/application/activity" mode="merge">
            <activity
                android:supportsPictureInPicture="true"
                android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation" />
        </edit-config>

        <source-file src="src/android/IotumHelperPlugin.java" target-dir="src/com/iotum/helper" />
    </platform>
</plugin>
