<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android" id="cordova-plugin-iotum-helper" version="1.2.2">
    <name>IotumHelper</name>
    <description>Iotum App Helpers</description>
    <author>Jerry Hu</author>

    <license>MIT</license>
    <keywords>cordova</keywords>

    <engines>
        <engine name="cordova" version=">=10.0.0" />
    </engines>

    <js-module src="www/iotum_helpers.js" name="IotumHelper">
        <clobbers target="cordova.plugins.iotumHelper" />
    </js-module>

    <platform name="ios">
        <config-file target="config.xml" parent="/*">
            <feature name="IotumHelper">
                <param name="ios-package" value="IotumHelperPlugin" />
                <param name="onload" value="true" />
            </feature>
        </config-file>

        <header-file src="src/ios/IotumHelperPlugin.h" />
        <source-file src="src/ios/IotumHelperPlugin.m" />
        <framework src="Intents.framework" weak="true" />

        <config-file target="*-Info.plist" parent="NSFocusStatusUsageDescription">
            <string>Allow access to your Focus status to know when notifications are silenced.</string>
        </config-file>

        <!-- Required by App Store validation for apps with the communication notifications entitlement (ITMS-90894) -->
        <config-file target="*-Info.plist" parent="NSUserActivityTypes">
            <array>
                <string>INStartCallIntent</string>
            </array>
        </config-file>

        <config-file target="Entitlements-*.plist" parent="com.apple.developer.usernotifications.communication">
            <true />
        </config-file>
    </platform>

    <platform name="android">
        <config-file parent="/*" target="res/xml/config.xml">
            <feature name="IotumHelper">
                <param name="android-package" value="com.iotum.iotumhelper.IotumHelperPlugin" />
                <param name="onload" value="true" />
            </feature>
        </config-file>

        <source-file src="src/android/IotumHelperPlugin.java" target-dir="src/com/iotum/iotumhelper" />
    </platform>
</plugin>
